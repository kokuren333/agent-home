# Discord app credentials. Never commit a real .env file.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Comma-separated Discord server IDs. DISCORD_GUILD_ID is still accepted for one server.
DISCORD_GUILD_IDS=
DISCORD_ADMIN_USER_IDS=

# Local paths. Keep machine-specific values in .env only.
EBE_VAULT_ROOT=
EBE_WORKTREE_ROOT=

# Concurrency. Article generation may run in parallel; publish/merge/push stays serial.
EBE_MAX_WORKERS=4
EBE_MAX_PUBLISHERS=1

# Codex defaults.
CODEX_DEFAULT_MODEL=gpt-5.5
CODEX_DEFAULT_REASONING_EFFORT=low
# Prompt is sent over stdin. Available placeholders: {model} {effort} {cwd} {promptFile}
CODEX_COMMAND_TEMPLATE=codex exec --model {model} -c model_reasoning_effort={effort} --cd {cwd} --dangerously-bypass-approvals-and-sandbox -

# Git publishing.
GIT_REMOTE=origin
GIT_BRANCH=main
GIT_COMMIT_MESSAGE=article update
GIT_BOT_USER_NAME=ebe-discord-bot
GIT_BOT_USER_EMAIL=ebe-discord-bot@example.invalid

# Optional GitHub Pages repository checkout. Deploy copies dist here and pushes changes.
EBS_GITHUB_PAGES_DIR=
EBS_PAGES_GIT_REMOTE=origin
EBS_PAGES_GIT_BRANCH=main
EBS_PAGES_GIT_COMMIT_MESSAGE=deploy: update site
EBS_PAGES_GIT_USER_NAME=ebs-pages-deployer
EBS_PAGES_GIT_USER_EMAIL=ebs-pages-deployer@example.invalid
EBS_AUTO_DEPLOY_ENABLED=false
EBS_CONTENT_ROOT=../../../discord_bot-runtime/content
# Set these for the actual Pages URL; leave blank for a custom domain/root deployment.
EBS_SITE_BASE_PATH=/your-pages-repository/
EBS_SITE_ORIGIN=https://your-account.github.io
# Required when auto-deploy verification is enabled. This is the final public
# site URL, including the Pages project path when applicable.
EBS_PAGES_PUBLIC_URL=https://your-account.github.io/your-pages-repository/

# Runtime storage must be outside the Vault checkout. Adjust the root when
# migrating to another server.
EBE_BOT_RUNTIME_DIR=C:\ebs\discord_bot-runtime
EBE_BOT_DATA_DIR=C:\ebs\discord_bot-runtime\data
EBE_BOT_LOG_DIR=C:\ebs\discord_bot-runtime\logs

# Resource guard checks before starting a new job.
EBE_RESOURCE_GUARD_ENABLED=true
EBE_MAX_MEMORY_PERCENT=85
EBE_MAX_CPU_PERCENT=95

# Daily news automation. Scheduled runs queue 10 field jobs at 06:00 JST.
EBE_DAILY_NEWS_ENABLED=true
DISCORD_DAILY_NEWS_CHANNEL_ID=
EBE_DAILY_NEWS_HOUR_JST=6
EBE_DAILY_NEWS_MINUTE_JST=0


# Worktree cleanup.
EBE_KEEP_FAILED_WORKTREES=true
EBE_KEEP_SUCCESSFUL_WORKTREES=false
# Runtime state must live outside the Vault Git checkout.
EBE_BOT_MANAGEMENT_EVENTS_FILE=C:\ebs\discord_bot-runtime\management-events.jsonl
