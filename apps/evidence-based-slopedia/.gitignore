# Evidence Based Everything generated knowledge artifacts
# Keep infrastructure, policies, configs, root MOCs, and .gitkeep files.

/skills/

.env
.env.*
!/automation/discord_bot/.env.example
/automation/discord_bot/data/
/automation/discord_bot/logs/
/automation/discord_bot-runtime/
/deployments/
/automation/discord_bot/node_modules/
**/node_modules/
/automation/discord_bot/.cache/
/automation/discord_bot/dist/

# EBS canonical state is intentionally trackable; derived output is rebuildable.
/canonical/.locks/

# Content is persisted outside this repository in EBS_CONTENT_ROOT.
/10_Published/
/11_Daily/
/50_Assets/
/canonical/metadata/articles/
/canonical/metadata/tombstones/
/canonical/revisions/

# Generated content is canonical in EBS_CONTENT_ROOT, never in AppRoot.
/10_Published/*/*/*.md
/11_Daily/**/*.md
/50_Assets/Articles/*
/50_Assets/Infographics/*
/canonical/metadata/articles/*
/canonical/metadata/tombstones/*
/canonical/revisions/*
/generated/
/dist/
/dist.tmp-*/
/dist.previous/

!/10_Published/*/*/.gitkeep

!/11_Daily/**/.gitkeep


/20_EvidencePackets/*
!/20_EvidencePackets/README.md
!/20_EvidencePackets/.gitkeep

/30_Sources/*
!/30_Sources/README.md
!/30_Sources/.gitkeep

/40_Claims/*
!/40_Claims/README.md
!/40_Claims/.gitkeep

/50_Assets/Infographics/*
!/50_Assets/Infographics/.gitkeep
/50_Assets/Diagrams/*
!/50_Assets/Diagrams/.gitkeep
/50_Assets/Attachments/*
!/50_Assets/Attachments/.gitkeep

/70_Logs/update_logs/*
!/70_Logs/update_logs/.gitkeep
/70_Logs/taxonomy_logs/*
!/70_Logs/taxonomy_logs/.gitkeep
/70_Logs/citation_audits/*
!/70_Logs/citation_audits/.gitkeep
/70_Logs/quality_audits/*
!/70_Logs/quality_audits/.gitkeep
/70_Logs/infographic_logs/*
!/70_Logs/infographic_logs/.gitkeep
/70_Logs/publish_logs/*
!/70_Logs/publish_logs/.gitkeep

/_working/**/*
!/_working/**/
!/_working/**/.gitkeep

# Local backup snapshots may contain private Vault history and are not source.
/backups/

/_archive/superseded_articles/*
!/_archive/superseded_articles/.gitkeep
/_archive/old_mocs/*
!/_archive/old_mocs/.gitkeep
/_archive/deprecated_sources/*
!/_archive/deprecated_sources/.gitkeep

/.obsidian/workspace*.json
/.obsidian/cache
/.trash/

__pycache__/
*.pyc
